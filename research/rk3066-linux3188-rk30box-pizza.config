# Key result of the 2026-08-08 disposable component build.
# This is a review fragment, not a complete defconfig. Use
# build/linux3188/build-rk30box-components.sh to resolve dependencies from
# rk3066b_sdk_defconfig.

CONFIG_SOC_RK3066=y
CONFIG_MACH_RK30_BOX_PIZZA=y
CONFIG_SDMMC_RK29=y
CONFIG_SDMMC0_RK29=y
CONFIG_SDMMC1_RK29=y
CONFIG_WLAN_80211=y
CONFIG_NL80211_TESTMODE=y
CONFIG_MT5931_MT6622=y
CONFIG_WIFI_CONTROL_FUNC=y
CONFIG_MALI=y
CONFIG_MALI400=m
CONFIG_MALI400_UMP=y
CONFIG_UMP=m
CONFIG_MFD_TPS65910=y
CONFIG_FB_ROCKCHIP=y
CONFIG_LCDC_RK30=y
CONFIG_LCDC0_RK30=y
CONFIG_LCDC1_RK30=y
CONFIG_RK_HDMI=y
CONFIG_HDMI_RK30=y
CONFIG_BOX_FB_720P=y
CONFIG_NO_DUAL_DISP=y

# These choices must be disabled for the source to select the MT5931/RBox
# path instead of the generic RKWIFI or RK3066B/M701 paths.
# CONFIG_RKWIFI is not set
# CONFIG_MFD_WM831X is not set
# CONFIG_MFD_WM831X_I2C is not set
# CONFIG_RTC_DRV_WM831X is not set
# CONFIG_MALI400_PROFILING is not set
# CONFIG_MALI400_INTERNAL_PROFILING is not set
