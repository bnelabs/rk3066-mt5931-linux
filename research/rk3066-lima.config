# Mainline Linux GPU fragment for RK3066 + Mali-400.
#
# This is intentionally not a complete kernel .config. It assumes the board
# configuration already selects the Rockchip ARM SoC architecture, device
# tree, clocks, power domains, storage, console, and networking.
#
# The GPU driver is built in for first-boot bring-up. It can be changed to
# CONFIG_DRM_LIMA=m after module packaging and initramfs are verified.

CONFIG_DRM=y
CONFIG_DRM_ROCKCHIP=y
CONFIG_ROCKCHIP_VOP=y
CONFIG_ROCKCHIP_RK3066_HDMI=y
CONFIG_DRM_LIMA=y
