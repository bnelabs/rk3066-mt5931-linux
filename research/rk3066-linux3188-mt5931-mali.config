# Linux3188 legacy-kernel enablement fragment for this device class.
#
# This is not a board defconfig. It must be merged into a verified RK3066
# configuration with MMC/SDIO, WLAN, modules, clocks, storage, and console
# support already selected.

CONFIG_WLAN_80211=y
CONFIG_MT5931_MT6622=y
CONFIG_MALI=y
CONFIG_MALI400_UMP=y
